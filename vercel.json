{
  "buildCommand": "npm run build:vercel",
  "git": {
    "deploymentEnabled": {
      "ci/p0b-prisma-migration-lock": false,
      "audit/commercial-readiness-20261024": false,
      "remediation/*": false
    }
  },
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/eod-summary",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/expire-online-orders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/dispatch-storefront-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retry-online-order-sales",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/subscription-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "app/api/cron/**": {
      "maxDuration": 60
    },
    "app/api/storefront/orders/[id]/stream/route.ts": {
      "maxDuration": 60
    },
    "app/api/seed-once/**": {
      "maxDuration": 60
    },
    "app/api/import-stock/**": {
      "maxDuration": 300
    },
    "app/api/reset-purchase-data/**": {
      "maxDuration": 30
    },
    "app/api/offline/batch-sync/**": {
      "maxDuration": 30
    },
    "app/api/qa/reliability-snapshot/route.ts": {
      "maxDuration": 30
    },
    "app/api/**": {
      "maxDuration": 15
    }
  }
}
